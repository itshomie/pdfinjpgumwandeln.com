---
import { pageBySlug, pathFor, site } from "../data/pages";

const navItems = [
  { label: "PDF in JPG", href: "/" },
  { label: "JPG in PDF", slug: "jpg-in-pdf-umwandeln" },
  { label: "PDF in SVG", slug: "pdf-in-svg-umwandeln" },
  { label: "Alle Tools", href: "/#alle-anleitungen" },
  { label: "Kontakt", href: "/kontakt/" }
].map((item) => {
  if ("href" in item) return item;
  const page = pageBySlug(item.slug);
  if (!page) throw new Error(`Navigation page not found: ${item.slug}`);
  return { label: item.label, href: pathFor(page) };
});
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Startseite">
    <span class="brand-mark" aria-hidden="true">PDF</span>
    <span>{site.name}</span>
  </a>
  <nav class="main-nav" aria-label="Hauptnavigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>
