---
import { homePage, pageBySlug, pathFor } from "../data/pages";

function linkFor(slug: string, label?: string) {
  const page = pageBySlug(slug);
  if (!page) throw new Error(`Directory page not found: ${slug}`);
  return {
    label: label ?? page.keyword,
    href: pathFor(page)
  };
}

const groups = [
  {
    title: "PDF in JPG",
    description: "Der Haupt-Workflow plus echte Unterschiede nach Nutzungssituation und Gerät.",
    pages: [
      { label: homePage.keyword, href: pathFor(homePage) },
      linkFor("pdf-in-jpg-umwandeln-online"),
      linkFor("pdf-in-jpg-umwandeln-windows"),
      linkFor("pdf-in-jpg-umwandeln-mac"),
      linkFor("pdf-in-jpg-umwandeln-handy"),
      linkFor("pdf-in-bilddatei-umwandeln")
    ]
  },
  {
    title: "JPG in PDF",
    description: "Bilder, Scans und Fotos als einzelne PDF-Datei speichern.",
    pages: [
      linkFor("jpg-in-pdf-umwandeln"),
      linkFor("mehrere-jpg-in-pdf-umwandeln"),
      linkFor("jpg-in-pdf-umwandeln-online"),
      linkFor("jpg-in-pdf-umwandeln-handy"),
      linkFor("jpg-in-pdf-umwandeln-windows"),
      linkFor("jpg-in-pdf-umwandeln-mac")
    ]
  },
  {
    title: "PDF in Spezialformate",
    description: "Gezielte Seiten für SVG, TIFF, EPS und Vektorprüfung.",
    pages: [
      linkFor("pdf-in-svg-umwandeln"),
      linkFor("pdf-in-tiff-umwandeln"),
      linkFor("pdf-in-eps-umwandeln"),
      linkFor("pdf-in-vektordatei-umwandeln")
    ]
  },
  {
    title: "SVG und TIFF zu PDF",
    description: "Rückwege für Grafiken, Scans und Archivdateien.",
    pages: [linkFor("svg-in-pdf-umwandeln"), linkFor("tiff-in-pdf-umwandeln")]
  }
];
---

<section class="keyword-directory" id="alle-anleitungen" aria-labelledby="directory-heading">
  <div class="directory-head">
    <h2 id="directory-heading">Alle Konverter und Anleitungen</h2>
    <p>
      Wähle den passenden Fall direkt aus. Die Liste führt zu eigenständigen
      Aufgaben statt zu mehrfachen Formulierungen desselben Vorgangs.
    </p>
  </div>
  <div class="directory-grid">
    {groups.map((group) => (
      <section class="directory-group">
        <h3>{group.title}</h3>
        <p>{group.description}</p>
        <ul>
          {group.pages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>
