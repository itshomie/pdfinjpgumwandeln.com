---
import Hero from "../components/Hero.astro";
import KeywordDirectory from "../components/KeywordDirectory.astro";
import SeoArticle from "../components/SeoArticle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homePage, pathFor } from "../data/pages";
import { schemaForPage } from "../lib/schema";
---

<BaseLayout
  title={homePage.title}
  description={homePage.description}
  canonicalPath={pathFor(homePage)}
  jsonLd={schemaForPage(homePage)}
>
  <Hero page={homePage} home />
  <KeywordDirectory />
  <SeoArticle page={homePage} />
</BaseLayout>
